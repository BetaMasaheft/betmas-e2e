{
  "name": "betmas-e2e",
  "version": "1.0.0",
  "description": "end to end test for betamasaheft",
  "scripts": {
    "test": "cypress run",
    "test:prod": "cypress run -b firefox --expose grepTags=-@container-only+-@perf+-@a11y,grepFilterSpecs=true,grepOmitFiltered=true",
    "test:container": "cypress run -b firefox --config baseUrl=http://localhost:8080/ --env grepTags='@container -@production-only -@slow -@a11y',grepFilterSpecs=true,grepOmitFiltered=true",
    "test:container:open": "cypress open --config baseUrl=http://localhost:8080/",
    "lighthouse:prod": "npx --yes @lhci/cli@0.15.1 autorun --config=lighthouserc.json",
    "lighthouse:container": "sed 's#https://betamasaheft.eu#http://localhost:8080#' lighthouserc.json > lighthouserc.container.json && npx --yes @lhci/cli@0.15.1 autorun --config=lighthouserc.container.json",
    "codacy:init": "codacy-cli init && codacy-cli install && node .codacy/patch-eslint.mjs && cp .codacy/languages-config.yaml .codacy/tools-configs/languages-config.yaml",
    "codacy:analyze": "codacy-cli analyze --tool eslint",
    "a11y:container": "cypress run --config baseUrl=http://localhost:8080/ --expose grepTags=@a11y,grepFilterSpecs=true,grepOmitFiltered=true",
    "a11y:prod": "cypress run -b firefox --config baseUrl=https://betamasaheft.eu/ --expose grepTags=@a11y,grepFilterSpecs=true,grepOmitFiltered=true",
    "bench:container": "cypress run --config baseUrl=http://localhost:8080/ --expose grepTags=@perf,grepFilterSpecs=true,grepOmitFiltered=true",
    "bench:catalog": "node scripts/catalog-benchmark.mjs",
    "test:catalog-bench": "node --test scripts/catalog-benchmark.test.mjs"
  },
  "author": "Duncan Paterson",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "axe-core": "^4.13.0",
    "cypress": "^16.1.1",
    "cypress-axe": "^1.7.0"
  },
  "overrides": {
    "cypress-axe": {
      "cypress": "$cypress"
    }
  }
}
