{
  "name": "betmas-e2e",
  "version": "1.0.0",
  "description": "end to end test for betamasaheft",
  "scripts": {
    "test": "cypress run",
    "test:prod": "cypress run -b firefox",
    "test:container": "cypress run -b firefox --config baseUrl=http://localhost:8080/ --env grepTags='@container -@production-only -@slow',grepFilterSpecs=true,grepOmitFiltered=true",
    "test:container:open": "cypress open --config baseUrl=http://localhost:8080/",
    "codacy:init": "codacy-cli init && codacy-cli install && node .codacy/patch-eslint.mjs && cp .codacy/languages-config.yaml .codacy/tools-configs/languages-config.yaml",
    "codacy:analyze": "codacy-cli analyze --tool eslint",
    "bench:container": "cypress run --config baseUrl=http://localhost:8080/ --expose grepTags=@perf,grepFilterSpecs=true,grepOmitFiltered=true"
  },
  "author": "Duncan Paterson",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@cypress/grep": "^6.0.2",
    "cypress": "^15.19.0"
  }
}
